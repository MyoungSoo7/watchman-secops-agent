# Watchman 설정 — 이 파일을 .env 로 복사해 채운다. .env 는 커밋 금지.

# LLM: nim(실사용) | mock(키 없이 파이프라인 검증)
LLM_MODE=mock
#NVIDIA_API_KEY=nvapi-...            # build.nvidia.com 발급
#NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Elasticsearch (read-only 계정 권장)
#ES_URL=https://127.0.0.1:9200
#ES_USER=watchman-ro
#ES_PASS=
#ES_VERIFY_TLS=0                     # 포트포워드/자체서명이면 0
#ES_ALLOWED_PATTERNS=logstash-*,fluent-bit-*,logs-*

# K8s API (read-only ServiceAccount 토큰)
#K8S_API=https://127.0.0.1:16444
#K8S_TOKEN=
#K8S_VERIFY_TLS=0

# 출력 (미설정이면 stdout)
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=your-telegram-chat-id

#WATCHMAN_PORT=8687
#AUDIT_PATH=./audit.jsonl
